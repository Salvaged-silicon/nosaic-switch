# PowerPC e500v2 (Freescale P2020) — the AS5610-52X.
#
# The architecture's defconfig is mpc85xx_smp_defconfig, which already carries
# the platform. This fragment is for what a switch needs on top of it, and for
# the things a defconfig aimed at reference boards leaves out.

# The platform. P2020 support is generic across the DS/RDB boards, and this
# board's device tree is compatible with "fsl,P2020RDB".
CONFIG_PPC_P2020=y
CONFIG_MPC85xx_RDB=y

# Console. ttyS0 at 115200 on this board -- the vendor kernel command line is
# console=ttyS0,115200, and a wrong rate makes a working board look hung.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# The switch ASIC is reached from userspace by mapping its PCI BAR, so PCI has
# to be there and the P2020's controller with it. Note the chip appears on PCI
# domain 1, not 0 -- a P2020 has more than one controller.
CONFIG_PCI=y
CONFIG_FSL_PCI=y

# Contiguous memory for the switch chip's DMA rings. The vendor kernel command
# line carries cma=32M, and the Trident+ needs a contiguous region the same way
# the Trident2+ does -- but on the Arista that is a memmap= reservation, and
# here it is CMA.
#
# CONFIG_DMA_CMA is deliberately NOT set: it depends on HAVE_DMA_CONTIGUOUS,
# which powerpc does not select (arm, arm64, mips, x86, riscv and others do).
# So this board gets the generic CMA pool without the DMA-API integration,
# which means a driver reaches it through cma_alloc() rather than by
# dma_alloc_coherent() drawing from it.
#
# That matters for the datapath when it is written: on x86 the BDE reserves its
# DMA window with memmap= and maps it through /dev/mem, and neither mechanism
# is what this board offers. Asking for DMA_CMA anyway is how you get a kernel
# that boots and silently has no CMA at all -- the build refuses it, which is
# how this was found.
CONFIG_CMA=y

# Storage. The operating system lives on a NAND-backed block device at
# /dev/sda with an ordinary partition table; the NOR flash holds firmware only
# and is reached as MTD.
CONFIG_MTD=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_MTD_CFI=y
CONFIG_MTD_CFI_INTELEXT=y
CONFIG_MTD_CFI_AMDSTD=y
# The NOR is one Spansion device, one byte wide, and its partitions are named
# in the device tree rather than on the command line. Spelled out because the
# u-boot environment lives in one of those partitions: without them there is no
# /proc/mtd, fw_setenv has nothing to write to, and the OS can neither set its
# own boot command nor ask for ONIE on the next boot.
CONFIG_MTD_CFI_I1=y
CONFIG_MTD_MAP_BANK_WIDTH_1=y
CONFIG_MTD_OF_PARTS=y

# The management port. Freescale's own MAC on this SoC.
CONFIG_GIANFAR=y

# Big-endian, and stated rather than inherited: this is the first NOSaic
# architecture that is not little-endian, and a great deal of code has never
# been compiled for one.
CONFIG_CPU_BIG_ENDIAN=y

# 36-bit physical addressing. mpc85xx_smp_defconfig turns this on; on the
# AS5610's P2020 it must be off, and the failure when it is not is a board that
# loads the image and then prints nothing at all -- no panic, no console, no
# clue. Found in EdgeNOS's boot notes rather than on the bench, which is the
# only reason it did not cost a day.
# CONFIG_PHYS_64BIT is not set
