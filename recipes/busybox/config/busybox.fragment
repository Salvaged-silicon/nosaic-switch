# NOSaic's additions to busybox's own defconfig.
#
# Built static on purpose. This is the first userspace on the box and it runs
# before anything has mounted the root it would load a shared libc from — the
# initramfs uses it to assemble the overlay and hand over. A dynamically linked
# busybox works fine once a system is up and is useless at the moment it is
# most needed.
CONFIG_STATIC=y

# busybox is PID 1 on the minimal profile. The plan has that tier running s6,
# which is a later package; until then busybox init boots the system, and it is
# a legitimate init in its own right for a box this small.
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y

# A console login, which is how the identity decision is actually implemented:
# the admin account exists with no password, and until one is set this is the
# only way in.
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_PASSWD=y
CONFIG_SU=y

# switch_root hands control from the initramfs to the real root, and pivot_root
# is its fallback. Without these the initramfs has nowhere to go.
CONFIG_SWITCH_ROOT=y
CONFIG_PIVOT_ROOT=y

# Enough to assemble an overlay and diagnose one that will not assemble.
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_MOUNT_LOOP=y
CONFIG_MKDIR=y
CONFIG_MKNOD=y
CONFIG_MODPROBE=y
CONFIG_INSMOD=y

# The shell that runs the initramfs script, and the pieces it needs.
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_LS=y
CONFIG_MV=y
CONFIG_CP=y
CONFIG_RM=y
CONFIG_SLEEP=y
CONFIG_DMESG=y
CONFIG_BLKID=y
CONFIG_FINDFS=y

# busybox 1.37's tc applet references CBQ scheduler structures that Linux
# removed from its uapi headers in the 6.x series, so it cannot compile against
# a current sysroot. Nothing here wants busybox's tc: traffic control belongs to
# iproute2, and on a switch it belongs to the datapath.
# CONFIG_TC is not set

# busybox 1.37's SHA hardware acceleration is x86-only in the code and
# unconditional in the configuration, which is an upstream bug rather than
# something to configure around: SHA1_HWACCEL defaults to y with no dependency
# on the architecture (libbb/Config.src:67), the declarations of
# sha1_process_block64_shaNI and friends sit behind
# `defined(__i386__) || defined(__x86_64__)` (libbb/hash_md5_sha.c:17), and the
# call site is guarded by ENABLE_SHA1_HWACCEL alone (:1193). So every non-x86
# target fails to compile libbb.
#
# Turned off everywhere rather than only where it breaks. Keeping it on x86
# would mean one architecture running different hash code from the others for
# ~590 bytes and a faster sha1sum, which no switch is waiting on.
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set

# The i2c applets, so a switch can be asked what is on its own platform bus.
#
# ⚠ THESE ARE A BRING-UP TOOL AND THE REASON THEY SHIP IS THAT THERE IS NO
#   SECOND CHANCE TO USE THEM.
#
# On a board whose sensors, fans and PSUs hang off an i2c mux nobody has
# mapped, the channel-to-device table has to be read off the hardware -- and
# the only moment that bus is both reachable and not owned by the vendor's own
# driver is while our image is running. The Cisco Nexus 3172TQ is the case in
# point: it HAS i2cdetect under NX-OS and no /dev/i2c-* nodes to use it on,
# because its board-controller module owns the bus.
#
# So the tools travel in the image rather than being fetched when wanted. They
# are a few kilobytes inside a binary that is already there, and the
# alternative is discovering they are missing during the one session that
# could have used them.
#
# i2ctransfer is the one to have beyond the obvious three: selecting a mux
# channel and reading a device behind it is a combined write-then-read, which
# i2cget cannot express.
CONFIG_I2CDETECT=y
CONFIG_I2CGET=y
CONFIG_I2CSET=y
CONFIG_I2CDUMP=y
CONFIG_I2CTRANSFER=y
