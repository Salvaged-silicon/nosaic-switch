# Toolchain sources, pinned by hash.
#
# Fetched at build time, never committed. A tag or a branch can move under
# you; a hash cannot.
CTNG_VERSION=1.28.0
CTNG_URL=https://github.com/crosstool-ng/crosstool-ng/releases/download/crosstool-ng-1.28.0/crosstool-ng-1.28.0.tar.xz
CTNG_SHA256=5750e29a2bda5cd8d67900592576b1670a1987a4dcd5e4f6beae09138a1f5699

# Component versions (gcc, glibc, binutils, kernel headers) are crosstool-NG's
# own defaults for this release. They are tested together upstream, which is
# most of the value: mismatched components are the usual way a toolchain build
# fails in a way nobody can read.
