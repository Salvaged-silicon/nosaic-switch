# crosstool-NG defconfig for aarch64 — generated by bootstrap/build.sh seed
# Seeded from upstream sample: aarch64-unknown-linux-gnu
# crosstool-NG: 1.28.0
#
# Regenerate with: make toolchain-seed ARCH=aarch64
# Do not hand-edit; put deliberate choices in ctng_overrides().
CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_ALLOW_BUILD_AS_ROOT=y
CT_ALLOW_BUILD_AS_ROOT_SURE=y
CT_LOCAL_TARBALLS_DIR="${CT_TOP_DIR}/../../dl"
CT_PREFIX_DIR="${CT_TOP_DIR}/../../toolchain/aarch64"
CT_ARCH_ARM=y
CT_ARCH_64=y
CT_TARGET_VENDOR="nosaic"
# CT_TOOLCHAIN_CMAKE_TOOLCHAIN_FILE is not set
CT_KERNEL_LINUX=y
CT_BINUTILS_PLUGINS=y
CT_GLIBC_KERNEL_VERSION_NONE=y
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
