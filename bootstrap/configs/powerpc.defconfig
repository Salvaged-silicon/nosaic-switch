# crosstool-NG defconfig for powerpc — generated by bootstrap/build.sh seed
# Seeded from upstream sample: powerpc-unknown_nofpu-linux-gnu
# crosstool-NG: 1.28.0
#
# Regenerate with: make toolchain-seed ARCH=powerpc
# Do not hand-edit; put deliberate choices in ctng_overrides().
CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_ALLOW_BUILD_AS_ROOT=y
CT_ALLOW_BUILD_AS_ROOT_SURE=y
CT_LOCAL_TARBALLS_DIR="${CT_TOP_DIR}/../dl"
CT_PREFIX_DIR="${CT_TOP_DIR}/../toolchain/powerpc"
CT_ARCH_POWERPC=y
CT_ARCH_FLOAT_SW=y
CT_TARGET_VENDOR="nosaic"
# CT_TOOLCHAIN_CMAKE_TOOLCHAIN_FILE is not set
CT_KERNEL_LINUX=y
CT_BINUTILS_PLUGINS=y
CT_CC_LANG_CXX=y
CT_DEBUG_DUMA=y
CT_DEBUG_GDB=y
CT_DEBUG_STRACE=y
