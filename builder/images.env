# Base images, pinned by digest.
#
# Pinned rather than tagged so a build is reproducible: a tag can be moved
# under you, a digest cannot. Refresh deliberately with builder/refresh.sh,
# never silently.
UBUNTU_DIGEST=sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517
UBUNTU_REF=ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# Toolchain versions used inside the builder.
GO_VERSION=1.27.0
GO_SHA256=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685

# Tag applied to the locally built builder image.
BUILDER_IMAGE=nosaic/builder:0.1
