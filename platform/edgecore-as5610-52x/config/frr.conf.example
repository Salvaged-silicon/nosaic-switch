# EXAMPLE ONLY -- this file is NOT shipped in the image and is NOT read by
# anything. It is the shape of the file plus the reasoning behind it.
#
# Every address, MAC and router-id below has been replaced by a placeholder.
# Put your own in
#
#     /mnt/data/config/frr.conf
#
# which lives on the data partition, so it survives an upgrade, a rollback and
# a reinstall -- and is never overwritten by an image built for this model.
#
# ⚠ THIS FILE USED TO CARRY ONE PHYSICAL SWITCH'S IDENTITY, IN A PUBLIC REPO.
# An image built from it made a second switch a duplicate of the first: same
# management address, same MAC, same OSPF router-id in the same area. Keep real
# values in <name>.site.conf, which .gitignore excludes, or on the switch.
#
# FRR configuration for this board, translated from the Quagga configuration
# the EdgeNOS installation runs today (/etc/quagga/{zebra,ospfd,ospf6d}.conf,
# read on 2026-09-02).
#
# One integrated file rather than three, which is what NOSaic's frr-siteconf
# service copies into place from /mnt/data/config/frr.conf. Quagga kept a file
# per daemon; FRR reads this one for all of them.
#
# Contains no site addressing beyond the router-id, which is RFC1918. The
# interface addresses live in network.conf beside this file.

frr version 10.2
frr defaults traditional
hostname nosaic-as5610
log syslog informational
service integrated-vtysh-config
!
# ── OSPF costs ───────────────────────────────────────────────────────────────
# 10 on the two uplinks and 40 on the 10G links, so the 40G path to the Nexus
# wins on its own rather than by tie-break. Ports with an address but no cost
# here are deliberately not in an area.
interface swp49
 ip ospf cost 10
 ipv6 ospf6 area 0.0.0.0
!
interface swp52
 ip ospf cost 10
 ipv6 ospf6 area 0.0.0.0
!
interface swp1
 ip ospf cost 40
 ipv6 ospf6 area 0.0.0.0
!
interface swp2
 ip ospf cost 40
 ipv6 ospf6 area 0.0.0.0
!
interface swp4
 ip ospf cost 40
 ipv6 ospf6 area 0.0.0.0
!
interface swp6
 ip ospf cost 40
 ipv6 ospf6 area 0.0.0.0
!
interface swp8
 ip ospf cost 40
 ipv6 ospf6 area 0.0.0.0
!
interface lo
 ip ospf passive
 ipv6 ospf6 area 0.0.0.0
!
# ── OSPFv2 ───────────────────────────────────────────────────────────────────
# The router-id is the loopback address, and lo is passive so the id is
# advertised without the loopback trying to form an adjacency with itself.
# Declared on the interface rather than as `passive-interface lo` in this
# stanza: Quagga spelled it that way, FRR 10.2 still accepts it and says
#
#   Please, use "ip ospf passive" on an interface instead.
#
# which is a deprecation that will one day be a removal.
#
# swp5 (<address>/<prefix>) and swp7 (<address>/<prefix>) carry addresses and are
# deliberately absent: EdgeNOS has no network statement covering either, so
# they are routed interfaces that do not participate in OSPF. Reproduced
# rather than tidied -- if that is wrong it is wrong on the running switch too,
# and this file should not silently disagree with it.
router ospf
 ospf router-id <address>
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
 network <address>/<prefix> area 0.0.0.0
!
# ── OSPFv3 ───────────────────────────────────────────────────────────────────
# Area membership is declared on the interfaces above, which is how FRR
# prefers it; Quagga listed them in the router stanza. Same result, and the
# interface form keeps each port's settings in one place.
router ospf6
 ospf6 router-id <address>
!
line vty
!
