# EXAMPLE ONLY -- this file is NOT shipped in the image.
#
# Every router-id and network below belong to ONE switch. Put your own in
#
#     /mnt/data/config/frr.conf
#
# which is on the data partition, so it survives an upgrade, a rollback and a
# reinstall -- and is never overwritten by an image built for this model.
#
# ⚠ THIS USED TO SHIP. An image built from this directory carried one lab
# switch's management address, its management MAC and its OSPF router-id, so a
# second switch built from the same source came up as a duplicate of the first.
# That is why the real values live off the image and only a shape lives here.
#
# FRR configuration for this board.
#
# The interface addresses live in network.conf beside this file; this one
# carries only the router-id and how each port participates in OSPF.
#
# ⚠ EVERY BLOCK ENDS WITH AN EXPLICIT `exit`.
#
# In FRR `!` is a COMMENT, not a node terminator. A file that separates blocks
# with `!` alone parses as one long nested stanza, and the failure is silent:
# the daemons start, vtysh shows a configuration, and adjacencies never form.
# This cost an evening on the predecessor project, where the whole OSPFv3
# configuration had been absorbed into the block above it. `vtysh -b` reports
# the parse errors that `vtysh -f` swallows -- use it to check a change.

frr version 10.2
frr defaults traditional
hostname <this switch>
log syslog informational
service integrated-vtysh-config
!
# ── Interfaces ───────────────────────────────────────────────────────────────
#
# et49 and et50 are the two 40G links to the 7050SX2 and carry the SAME cost on
# purpose: equal cost is what makes them an ECMP pair rather than a primary and
# a backup. Changing one of these numbers alone silently turns the pair into a
# single path with a spare.
interface et49
 ip ospf cost 10
 ipv6 ospf6 area 0.0.0.0
exit
!
interface et50
 ip ospf cost 10
 ipv6 ospf6 area 0.0.0.0
exit
!
# et52 is the 40G link to the Edgecore AS5610. Deliberately more expensive than
# the SX2 pair, so it stays available as a path without attracting transit.
interface et52
 ip ospf cost 40
 ipv6 ospf6 area 0.0.0.0
exit
!
# The loopback is passive: the router-id is advertised without the loopback
# trying to form an adjacency with itself.
interface lo
 ip ospf passive
 ipv6 ospf6 area 0.0.0.0
exit
!
# ⚠ eth0 IS ABSENT AND MUST STAY ABSENT.
#
# The management port is not in any area. OSPF on it would learn a route
# covering the subnet this switch is managed from, and a more specific learned
# route beats the pinned default -- so the box would leave the network the
# moment an adjacency came up, with its management route still present and
# still correct. network.conf pins that path for the same reason.
!
# ── OSPFv2 ───────────────────────────────────────────────────────────────────
#
# The router-id is the loopback address, which is the one address that does not
# depend on a link staying up.
router ospf
 ospf router-id <router-id>
 network <subnet>/<prefix> area 0.0.0.0
 network <subnet>/<prefix> area 0.0.0.0
 network <subnet>/<prefix> area 0.0.0.0
 network <subnet>/<prefix> area 0.0.0.0
exit
!
# ── OSPFv3 ───────────────────────────────────────────────────────────────────
#
# Area membership is declared on the interfaces above, which is how FRR prefers
# it. OSPFv3 runs over link-local addresses, so the transit links need no
# global IPv6 address for an adjacency to form.
router ospf6
 ospf6 router-id <router-id>
exit
!
line vty
exit
!
