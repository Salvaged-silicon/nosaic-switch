# build output
/out/
/build/
/.cache/

# toolchains and sysroots (large, reproducible from bootstrap/)
/toolchain/
/sysroot/

# fetched vendor sources — pinned by recipe, never committed
/dl/

# Go
*.test
/vendor/

# editors / OS
.DS_Store
*.swp
*~

# host-specific build overrides
local.mk
.source-set

# Site configuration, generated from your own switch.
#
# The port map and SerDes polarity are read off a machine already running the
# vendor's OS, so the numbers are the vendor's and are not ours to publish.
# They are still *board* data rather than per-unit data, so they belong in the
# image you build -- the image builder copies platform/<board>/config/ into
# /etc/nosaic, which is the first place the datapath looks. Generate them once
# with the scripts in platform/<board>/tools/ and drop them here.
/platform/*/config/portmap.conf
/platform/*/config/polarity.conf
/platform/*/config/statusleds.conf
# Where each of the AS4610-54T's 48 copper PHYs answers on MDIO. Same rule:
# read off a switch running the vendor's OS, so the numbers are the vendor's.
/platform/*/config/phymap.conf

# ⚠ One exception, and the reason is the provenance rather than the filename.
# The 7050TX-64's lamps are on the SCD rather than the fan CPLD, so its map is
# register offsets that are already public facts in that board's hardware.md
# plus the palette from Arista's published GPL scd-led driver. None of it is
# read out of a vendor file, so there is nothing to keep out of the tree -- and
# shipping it means the panel works on a fresh install rather than waiting for
# somebody to run a generator against a switch.
!/platform/arista-7050tx-64/config/statusleds.conf
/platform/*/config/authorized_keys

# Site configuration: real addressing that belongs to a particular lab rather
# than to the board. Kept beside the board it configures, out of the public
# tree.
*.site.conf

# Datapath build artifacts. They live in the source tree because that is where
# make runs, and a stale one is worse than none: the package builder copies the
# tree, make finds the binary newer than its sources, and the wrong
# architecture's object files ship. The arch check catches it, but only after a
# full build.
datapath/*/*.o
datapath/*/nosd-*
datapath/*/tdp-probe
datapath/*/fm6000-probe

# The C CLI, for the same reason: it builds in its own directory and the
# package builder copies the tree. This was missing while the datapath's
# equivalent was not, so an in-tree `make` in cli/ left artifacts staged for
# commit.
cli/*.o
cli/nosaic

# The serial-console driver used to reach a board over a terminal server. It
# lives at the repository root only because the Bash permission rule that
# allows it matches on "python3 con.py", and the working directory resets
# between calls. It is a local operator tool, not part of the build.
/con.py
refs/

# The repeater's tuning is per-board, comes from the board's own description
# file, and is the vendor's rather than ours -- same rule as the port map.
/platform/*/config/retimer.conf

# SerDes transmit equalisation: per-trace tuning from the board description.
/platform/*/config/serdes.conf

# The FM6000 scaffold: relocated vendor capture, fetched on demand by
# datapath/fm6000/scaffold/fetch.sh and deleted block by block as real
# generators replace it. Deliberately not in the repository -- an image that
# can be redistributed is the whole reason this board is being ported, and a
# tree carrying 130,000 lines of somebody else's captured boot is not one,
# however the directory is labelled. See that directory's README.
/datapath/fm6000/scaffold/fm6000_*.c
